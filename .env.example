# Local development configuration. Copy to `.env` and adjust.
# `.env` is gitignored — never commit real secrets.

DEBUG=True
SECRET_KEY=dev-only-insecure-key-change-me-before-deploying
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# sqlite (default) or postgres
DB_ENGINE=sqlite
# POSTGRES_DB=audioplayer
# POSTGRES_USER=audioplayer
# POSTGRES_PASSWORD=audioplayer
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

JWT_SIGN_IN_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=7

MAX_UPLOAD_SIZE_MB=50

# Comma-separated origins allowed to call the API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000

# locmem (default) or redis
# CACHE_BACKEND=redis
# REDIS_URL=redis://127.0.0.1:6379/1

# MEDIA_ROOT=/var/www/audioplayer/media

# Signed-stream lifetime (seconds) and the two gates that decide whether
# streaming/downloading needs a token or a login.
STREAM_URL_TTL_SECONDS=3600
STREAM_REQUIRE_AUTH=False
DOWNLOADS_REQUIRE_AUTH=True

# Per-play royalty used by `manage.py`-driven artist payouts (decimal string).
PAYOUT_RATE_PER_PLAY=0.004

# HLS packaging (opt-in). Requires ffmpeg on PATH.
HLS_ENABLED=False
HLS_SEGMENT_SECONDS=6
HLS_VARIANTS=128,192
FFMPEG_BINARY=ffmpeg

# SMTP is required to deliver password-reset/verification email from a real
# deployment; the default console backend just writes messages to the logs.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=no-reply@example.com
# EMAIL_HOST_PASSWORD=change-me
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Auralis <no-reply@example.com>

LOG_LEVEL=INFO
