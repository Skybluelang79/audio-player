# Local development configuration. Copy to `.env` and adjust.
# `.env` is gitignored — never commit real secrets.

DEBUG=True
SECRET_KEY=dev-only-insecure-key-change-me-before-deploying
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# sqlite (default) or postgres
DB_ENGINE=sqlite
# POSTGRES_DB=audioplayer
# POSTGRES_USER=audioplayer
# POSTGRES_PASSWORD=audioplayer
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

JWT_SIGN_IN_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=7

MAX_UPLOAD_SIZE_MB=50

# Comma-separated origins allowed to call the API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000

# locmem (default) or redis
# CACHE_BACKEND=redis
# REDIS_URL=redis://127.0.0.1:6379/1

# MEDIA_ROOT=/var/www/audioplayer/media

LOG_LEVEL=INFO
