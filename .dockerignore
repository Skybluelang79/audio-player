# Keep the build context to what the image actually needs. Collected static
# files are regenerated by `collectstatic` inside the image; media is served
# from object storage at runtime.

.git
.gitignore
.gitattributes

# Local virtualenvs (Windows or POSIX) must never leak into the Linux image.
.venv
venv

# Python caches
__pycache__
*.py[cod]
*.egg-info

# Tooling caches
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov

# Local runtime state
.env
db.sqlite3
db.sqlite3-journal
media
staticfiles
*.log

# Agent workspace
.kilo
